# Copy to .env and fill in. NEVER commit .env.
# Leave optional lines commented out: an EMPTY value overrides the built-in default.

# --- Required ---
GEMINI_API_KEY=your-gemini-key
# Only needed for PDF, DOCX, PPTX and image parsing.
LLAMA_CLOUD_API_KEY=your-llamacloud-key

# --- API security ---
# Comma-separated list. Leave empty ONLY on your own machine (authentication is then off).
ADAPTIVE_RAG_API_KEYS=change-me-to-a-long-random-string
ADAPTIVE_RAG_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Optional (defaults live in adaptive_rag/config.py) ---
# GEMINI_MODEL=
# QDRANT_URL=http://localhost:6333
# QDRANT_COLLECTION=pipeline_collection
# ADAPTIVE_RAG_DATA_DIR=./data
# ADAPTIVE_RAG_STORAGE_DIR=./storage
# ADAPTIVE_RAG_CACHE_DIR=./cache
# ADAPTIVE_RAG_API_HOST=127.0.0.1
# ADAPTIVE_RAG_API_PORT=8000
# MAX_UPLOAD_SIZE_MB=100
